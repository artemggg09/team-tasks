# Окружение: local (ошибки на экране) или production (ошибки только в лог)
APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow

# SQLite (по умолчанию). Относительный путь считается от корня проекта.
DB_DSN=sqlite:storage/database.sqlite
DB_USER=
DB_PASS=

# MySQL / MariaDB:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=team_tasks;charset=utf8mb4
# DB_USER=root
# DB_PASS=secret
