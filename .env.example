# Окружение: local (ошибки на экране) или production (ошибки только в лог)
APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow

# MySQL / MariaDB (основной вариант). Базу нужно создать заранее:
#   CREATE DATABASE team_tasks CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# В OSPanel 6 у MySQL свой адрес (например, 127.0.1.31) — см. «Модули» в OSPanel.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=team_tasks;charset=utf8mb4
DB_USER=root
DB_PASS=

# SQLite (без сервера БД; относительный путь считается от корня проекта):
# DB_DSN=sqlite:storage/database.sqlite
